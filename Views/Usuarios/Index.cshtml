
@model List<YaVa.Models.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Gestión de usuarios</h2>
            <p class="text-muted">Administrá los empleados de YaVa.</p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Create"
           class="btn btn-primary">
            + Nuevo empleado
        </a>
    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success mb-3">
            @mensaje
        </div>
    }

    @if (TempData["MensajeError"] is string error)
    {
        <div class="alert alert-danger mb-3">
            @error
        </div>
    }

    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.NombreUsuario</td>

                    <td>@usuario.Rol</td>

                    <td>
                        @if (usuario.EstaDesactivado)
                        {
                            <span class="badge bg-danger">
                                Desactivado
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success">
                                Activo
                            </span>
                        }
                    </td>

                    <td>
                        @if (usuario.Rol != "Administrador")
                        {
                            <div class="d-flex gap-2 align-items-center">

                                <a asp-controller="Usuarios"
                                   asp-action="Edit"
                                   asp-route-id="@usuario.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Editar
                                </a>

                                @if (usuario.EstaDesactivado)
                                {
                                    <form asp-controller="Usuarios"
                                          asp-action="Reactivar"
                                          method="post"
                                          class="m-0">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@usuario.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Reactivar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Usuarios"
                                          asp-action="Desactivar"
                                          method="post"
                                          class="m-0">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@usuario.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Seguro que querés desactivar este empleado?')">
                                            Desactivar
                                        </button>
                                    </form>
                                }

                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
