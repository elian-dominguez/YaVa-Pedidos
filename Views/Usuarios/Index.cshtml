@model List<YaVa.Models.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

<section class="users-page">

    <div class="users-header d-flex flex-column flex-md-row
                justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <span class="users-eyebrow">ADMINISTRACIÓN / EQUIPO</span>
            <h1 class="users-title">Gestión de usuarios</h1>
            <p class="users-subtitle mb-0">
                Administrá los empleados de YaVa.
            </p>
        </div>

        <a asp-controller="Usuarios"
           asp-action="Create"
           class="btn btn-primary px-4">
            + Nuevo empleado
        </a>
    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alert alert-success mb-3">
            @mensaje
        </div>
    }

    @if (TempData["MensajeError"] is string error)
    {
        <div class="alert alert-danger mb-3">
            @error
        </div>
    }

    <div class="card users-table-card">

        <div class="users-table-heading">
            <div>
                <h2 class="h5 mb-0">Empleados</h2>
            </div>
            <span class="users-count">
                @Model.Count usuarios
            </span>
        </div>

        <div class="table-responsive">
            <table class="table users-table mb-0">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                <span class="users-name">@usuario.NombreUsuario</span>
                            </td>
                            <td>
                                <span class="users-role">@usuario.Rol</span>
                            </td>
                            <td>
                                @if (usuario.EstaDesactivado)
                                {
                                    <span class="users-status users-status-inactive">
                                        <span class="users-status-dot"></span>
                                        Desactivado
                                    </span>
                                }
                                else
                                {
                                    <span class="users-status users-status-active">
                                        <span class="users-status-dot"></span>
                                        Activo
                                    </span>
                                }
                            </td>
                            <td>
                                @if (usuario.Rol != "Administrador")
                                {
                                    <div class="d-flex flex-wrap justify-content-end gap-2">

                                        <a asp-controller="Usuarios"
                                           asp-action="Edit"
                                           asp-route-id="@usuario.Id"
                                           class="btn btn-sm users-edit-btn">
                                            Editar
                                        </a>

                                        @if (usuario.EstaDesactivado)
                                        {
                                            <form asp-controller="Usuarios"
                                                  asp-action="Reactivar"
                                                  method="post"
                                                  class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@usuario.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm users-enable-btn">
                                                    Reactivar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Usuarios"
                                                  asp-action="Desactivar"
                                                  method="post"
                                                  class="m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@usuario.Id" />
                                                <button type="submit"
                                                        class="btn btn-sm users-disable-btn"
                                                        onclick="return confirm('¿Seguro que querés desactivar este empleado?')">
                                                    Desactivar
                                                </button>
                                            </form>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</section>
