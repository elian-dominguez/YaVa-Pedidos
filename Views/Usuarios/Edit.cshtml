@model YaVa.Models.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar empleado";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" asp-append-version="true" />
}

<section class="users-page">

    <a asp-controller="Usuarios" asp-action="Index" class="users-back-link">
        ← Volver a usuarios
    </a>

    <div class="mb-4">
        <span class="users-eyebrow">ADMINISTRACIÓN / EQUIPO</span>
        <h1 class="users-title">Editar empleado</h1>
        <p class="users-subtitle mb-0">
            Modificá el puesto de trabajo del empleado.
        </p>
    </div>

    <div class="card users-form-card">
        <div class="users-form-body">

            <form asp-controller="Usuarios" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Nombre de usuario</label>
                    <input value="@Model.NombreUsuario"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-4">
                    <label asp-for="Rol" class="form-label">
                        Puesto de trabajo
                    </label>
                    <select asp-for="Rol" class="form-select">
                        <option value="Caja">Caja</option>
                        <option value="Cocina">Cocina</option>
                        <option value="Mostrador">Mostrador</option>
                    </select>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>

                <div class="users-form-actions">
                    <a asp-action="Index" class="btn users-cancel-btn">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        Guardar cambios
                    </button>
                </div>
            </form>

        </div>
    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
