
@using YaVa.Controllers
@model List<Pedido>

@{
    var columnas = new (EstadoPedido Estado, string Titulo, string Color, string Clase, string Descripcion)[]
    {
        (EstadoPedido.Pendiente, "Pendientes", "secondary", "pending", "Esperando para comenzar"),
        (EstadoPedido.EnPreparacion, "En preparación", "warning", "preparing", "Pedidos en cocina"),
        (EstadoPedido.Listo, "Listos para entregar", "success", "ready", "Esperando entrega")
    };

    string TextoBoton(EstadoPedido siguiente) => siguiente switch
    {
        EstadoPedido.EnPreparacion => "Empezar a preparar",
        EstadoPedido.Listo => "Marcar listo",
        EstadoPedido.Entregado => "Marcar entregado",
        _ => "Avanzar"
    };
}

<div class="row g-4 orders-board">

    @foreach (var columna in columnas)
    {
        var pedidos = Model.Where(p => p.Estado == columna.Estado).ToList();

        <div class="col-lg-4">

            <section class="orders-column orders-column-@columna.Clase">

                <!-- Encabezado de columna -->
                <div class="orders-column-header">

                    <div class="orders-column-heading">
                        <span class="orders-column-indicator"></span>

                        <div>
                            <h2>@columna.Titulo</h2>
                            <p>@columna.Descripcion</p>
                        </div>
                    </div>

                    <span class="orders-column-count">
                        @pedidos.Count
                    </span>

                </div>

                <!-- Contenido -->
                <div class="orders-column-body">

                    @if (pedidos.Count == 0)
                    {
                        <div class="orders-empty">
                            <div class="orders-empty-icon">
                                @if (columna.Estado == EstadoPedido.Pendiente)
                                {
                                    <span>01</span>
                                }
                                else if (columna.Estado == EstadoPedido.EnPreparacion)
                                {
                                    <span>02</span>
                                }
                                else
                                {
                                    <span>03</span>
                                }
                            </div>

                            <h3>Sin pedidos</h3>

                            <p>
                                No hay pedidos en esta etapa por el momento.
                            </p>
                        </div>
                    }

                    @foreach (var pedido in pedidos)
                    {
                        var siguiente = PedidosController.SiguienteEstado(pedido.Estado);
                        var rolNecesario = siguiente is not null
                            ? PedidosController.RolQuePuedePasarA(siguiente.Value)
                            : null;

                        <article class="orders-ticket" data-pedido="@pedido.Id">

                            <!-- Encabezado del pedido -->
                            <div class="orders-ticket-header">
                                <div>
                                    <span class="orders-ticket-label">PEDIDO #@pedido.Id</span>
                                    <h3>Mesa @pedido.Mesa</h3>
                                </div>

                                <span class="orders-ticket-time">
                                    @pedido.CreadoEn.ToString("HH:mm")
                                </span>
                            </div>

                            <!-- Productos -->
                            <div class="orders-ticket-items">

                                @foreach (var item in pedido.Items)
                                {
                                    <div class="orders-ticket-item">
                                        <span>
                                            <strong>@item.Cantidad x</strong>
                                            @(item.Producto?.Nombre ?? "?")
                                        </span>

                                        <span class="orders-item-price">
                                            @((item.Cantidad * item.PrecioUnitario).ToString("C0"))
                                        </span>
                                    </div>
                                }

                            </div>

                            <!-- Total y acción -->
                            <div class="orders-ticket-footer">

                                <div class="orders-ticket-total">
                                    <small>TOTAL</small>
                                    <strong>@pedido.Total.ToString("C0")</strong>
                                </div>


                                @if (siguiente is not null &&
                                    (User.IsInRole("Administrador") ||
                                     (rolNecesario is not null && User.IsInRole(rolNecesario))))
                                {
                                    <form asp-controller="Pedidos"
                                          asp-action="CambiarEstado"
                                          method="post"
                                          class="m-0">

                                        <input type="hidden"
                                               name="id"
                                               value="@pedido.Id" />

                                        <input type="hidden"
                                               name="estado"
                                               value="@siguiente" />

                                        <button type="submit"
                                                class="btn orders-advance-btn">
                                            @TextoBoton(siguiente.Value) →
                                        </button>

                                    </form>
                                }

                            </div>

                        </article>
                    }

                </div>

            </section>

        </div>
    }

</div>
